    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "x = np.linspace(-2, 2, 5)\n",
    "y = np.linspace(-2, 2, 5)\n",
    "\n",
    "X, Y = np.meshgrid(x, y)\n",
    "Z = X**2 + Y**2\n",
    "\n",
    "# plt.scatter(x, y)\n",
    "plt.contour(X, Y,Z, )\n",
    "print(Z)\n",
    "plt.show()"
   ],
